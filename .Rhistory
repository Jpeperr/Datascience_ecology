fitHMM_stepangle <- momentuHMM::fitHMM(
data     = preppedDat,
nbStates = 3,
dist     = list(step = "gamma",
angle = "wrpcauchy"),
Par0     = list(step = c( 0.2,   0.5, 1.0,   # parameters for mean step, 3 states
0.25, 0.75, 1.25), # parameters for sd step, 3 states
angle = c(0.2,   0.4, 0.6))) # parameters for angle concentration, 3 states
fitHMM_stepangle
plot(fitHMM_stepangle, animals = 2)
