# dimension reduction
# retrieve numerical features and store it in datx
datx <- dat %>%
select(-c(ID, dttm, burst, t, label, x, y)) %>%
mutate(angle = cos(angle)) %>% # overwrite column angle with the cosine of angel
filter(angle != NA) # only keep records with an angle that is not NA
# dimension reduction
# retrieve numerical features and store it in datx
datx <- dat %>%
select(-c(ID, dttm, burst, t, label, x, y)) %>%
mutate(angle = cos(angle)) %>% # overwrite column angle with the cosine of angel
drop_na(angle) # only keep records with an angle that is not NA
# store the labels in the column label and dat in an vector called datxLabels
datxLabels <- dat %>%
drop_na(angle) %>%
pull(label)
# using table function on an vector to count number og occurrences of each label
table(datxLabels)
# or count on a tibble
dat %>%
drop_na(angle) %>%
count(label)
# apply PCA on the data datx and assign the result to an object called datx_pca
datx_pca <- datx %>%
prcomp(scale. = TRUE)
datx_pca
summary(datx_pca)
names(datx_pca)
# plot a barplot of sdev and calculate the fraction of total variance explained by the first 2
# principal components
barplot(datx_pca$sdev)
# plot a barplot of sdev and calculate the fraction of total variance explained by the first 2
# principal components
barplot(datx_pca$sdev,
col = "turqoise")
# plot a barplot of sdev and calculate the fraction of total variance explained by the first 2
# principal components
barplot(datx_pca$sdev,
col = rgb(0.2,0.4,0.6,0.6))
# plot a barplot of sdev and calculate the fraction of total variance explained by the first 2
# principal components
barplot(datx_pca$sdev,
col = "#69b3a2")
# calculate the fraction of total variance explained by the first 2 principal components
datx_pca$sdev^2 / sum(datx_pca$sdev^2)
(cumsum(exp_var)[2])
# calculate the fraction of total variance explained by the first 2 principal components
# variance per axis
exp_var <- datx_pca$sdev^2 / sum(datx_pca$sdev^2)
(cumsum(exp_var)[2])
datx_pca
plot(seq_along(datx_pca$sdev),
100 * cumsum(datx_pca$sdev^2) / sum(datx_pca$sdev^2),
xlab = "Number of PC included",
ylab = "Cumulative variance explained (%)",
type = "b")
datx_pca$x
