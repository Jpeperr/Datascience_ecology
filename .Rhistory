# clustering
k3 <- datx %>%
kmeans(centers = 3)
k3$centers
# scatterplot of the two t-SNE axes but with color of points indicating
# the assigned cluster according to K-means algorithm
dat_tsne %>%
ggplot(aes(x = V1,
y = V2,
col = k3$cluster)) +
geom_point() +
coord_fixed() # to have a 1:1 ratio on x and y axis
k3$cluster
factor(k3$cluster)
# clustering
# K-means algorithm
k3 <- datx %>%
kmeans(centers = 3)
# retrieve the value of the three centers
dat_K <- dat_tsne %>%
mutate(cluster = factor(k3$cluster))
# scatterplot of the two t-SNE axes but with color of points indicating
# the assigned cluster according to K-means algorithm
dat_K %>%
ggplot(aes(x = V1,
y = V2,
col = cluster)) +
geom_point() +
coord_fixed() # to have a 1:1 ratio on x and y axis
glimpse(dat_K)
dat_K
