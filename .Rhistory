setwd("~/Documents/GitHub/Datascience_ecology")
for (site in sites) {
# 1. Build the path to the current site's image folder
site_path <- file.path("data/raw/data/", site)
# 2. List all image files (case-insensitive .JPG)
im <- list.files(site_path, pattern = "\\.jpg$", full.names = TRUE, ignore.case = TRUE)
# 3. Extract file names
file_names <- basename(im)
# 4. Extract date strings and convert to Date
date_strings <- substr(file_names, 1, 10)
dates <- as.Date(date_strings, format = "%Y-%m-%d")
# 5. Filter for Mondays
is_monday <- weekdays(dates) == "Monday"
monday_files <- im[is_monday]
# 6. Create output folder for this site
out_dir <- file.path("data_challenges/data/raw_2", paste0(site, "_mondays"))
dir.create(out_dir, showWarnings = FALSE)
# 7. Copy Monday images to the new folder
file.copy(from = monday_files,
to = file.path(out_dir, basename(monday_files)))
cat("Copied", length(monday_files), "Monday files for", site, "\n")
}
